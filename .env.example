# Application Settings
APP_NAME="Lakshya Multimodal AI Studio"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Single Centralized Google AI Studio Key (Get free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Database (Default to sqlite for instant, zero-config local run; supports mysql)
DB_DIALECT=sqlite
SQLITE_DB_PATH=./data/chatbot.db

# Optional MySQL configuration (if DB_DIALECT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=multimodal_chatbot
MYSQL_USER=root
MYSQL_PASSWORD=root

# Security
MAX_UPLOAD_SIZE_MB=10
